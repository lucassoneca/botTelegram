# Token do Bot gerado pelo @BotFather
TELEGRAM_BOT_TOKEN=seu_bot_token_aqui

# Identificador do Canal/Grupo onde as ofertas serão postadas
# Exemplo: @nome_do_seu_canal 
TELEGRAM_CHAT_ID=@seu_canal_de_ofertas

# Tag ou ID de afiliado do Mercado Livre
MERCADO_LIVRE_AFFILIATE_TAG=@sua_tag_do_ML
# Intervalo em segundos para checagem de novas ofertas (ex: 60)
CHECK_INTERVAL_SECONDS=60

# Desconto mínimo (%) para uma oferta ser selecionada
MIN_DISCOUNT_PERCENT=10

# Quantidade máxima de ofertas postadas por ciclo (com pausa de 2.5s entre cada uma)
MAX_POSTS_PER_RUN=5

# Quantidade de páginas de ofertas a varrer a cada ciclo (padrão: 8)
MAX_PAGES_TO_SCRAPE=8
