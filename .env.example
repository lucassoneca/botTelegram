# Token do Bot gerado pelo @BotFather
TELEGRAM_BOT_TOKEN=seu_bot_token_aqui

# Identificador do Canal/Grupo onde as ofertas serão postadas
# Exemplo: @nome_do_seu_canal ou -1001234567890
TELEGRAM_CHAT_ID=@seu_canal_de_ofertas

# Tag ou ID de afiliado do Mercado Livre (ex: matt_tool=55667046&matt_word=seunome&forceInApp=true)
MERCADO_LIVRE_AFFILIATE_TAG=matt_tool=55667046&matt_word=seunome&forceInApp=true

# Intervalo em segundos para checagem automática de ofertas (ex: 30)
CHECK_INTERVAL_SECONDS=30
CHECK_INTERVAL_MINUTES=1

# Desconto mínimo (%) para uma oferta ser selecionada
MIN_DISCOUNT_PERCENT=15

# Quantidade máxima de ofertas postadas por ciclo
MAX_POSTS_PER_RUN=2
